# Smart Package Locker - Environment Configuration

# Server Port
PORT=5000

# JWT Authentication Secret (Change this in production)
JWT_SECRET=super_secret_jwt_key_smart_package_locker_2026_xyz987

# ESP32 Device Authentication Token (Must match the token in smart_package_locker.ino)
DEVICE_AUTH_TOKEN=esp32_smart_locker_secure_token_982341

# Base URL of frontend application for shareable delivery access links
# Replace with your LAN IP (e.g., http://192.168.1.100:5173) for testing courier access on smartphone
APP_BASE_URL=http://localhost:5173

# Initial Owner Credentials (Created on first run if database is empty)
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_PASSWORD=Owner@Locker2026!
INITIAL_OWNER_NAME=Smart Locker Owner
INITIAL_OWNER_EMAIL=owner@smartlocker.internal
INITIAL_OWNER_PHONE=+91 98450 12345

# Pickup Reminder Duration in Minutes (default 120 = 2 hours)
PICKUP_REMINDER_MINUTES=120

# ESP32 Heartbeat Offline Timeout in Seconds (default 30)
HEARTBEAT_TIMEOUT_SECONDS=30
